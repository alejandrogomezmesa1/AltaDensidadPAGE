{
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/top10.html", "destination": "/top10", "permanent": true },
    { "source": "/envases.html", "destination": "/envases", "permanent": true },
    { "source": "/nosotros.html", "destination": "/nosotros", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/reset.html", "destination": "/reset", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/success.html", "destination": "/success", "permanent": false },
    { "source": "/failure.html", "destination": "/failure", "permanent": false },
    { "source": "/pending.html", "destination": "/pending", "permanent": false }
  ],
  "rewrites": [
    { "source": "/img/:path*", "destination": "/assets/img/:path*" },
    { "source": "/capacitacion", "destination": "/plataforma-capacitacion/index.html" },
    { "source": "/capacitacion/:path*", "destination": "/plataforma-capacitacion/:path*" },
    { "source": "/induccion", "destination": "/plataforma-capacitacion/index.html" },
    { "source": "/induccion/:path*", "destination": "/plataforma-capacitacion/:path*" },
    { "source": "/((?!assets/|plataforma-capacitacion/).*)", "destination": "/index.html" }
  ]
}
