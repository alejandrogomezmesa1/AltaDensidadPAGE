{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "plataforma-capacitacion/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/assets/img/(.*)", "dest": "/assets/img/$1" },
    { "src": "/img/(.*)", "dest": "/assets/img/$1" },
    { "src": "/assets/(.*\\.(css|js|avif|png|jpg|jpeg|gif|webp|svg|ico|woff2?))", "dest": "/assets/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/nosotros", "dest": "/nosotros.html" },
    { "src": "/top10", "dest": "/top10.html" },
    { "src": "/envases", "dest": "/envases.html" },
    { "src": "/reset", "dest": "/reset.html" },
    { "src": "/capacitacion", "dest": "/plataforma-capacitacion/index.html" },
    { "src": "/capacitacion/(.*)", "dest": "/plataforma-capacitacion/$1" },
    { "src": "/induccion", "dest": "/plataforma-capacitacion/index.html" },
    { "src": "/induccion/(.*)", "dest": "/plataforma-capacitacion/$1" },
    { "src": "/(.*)\\.html", "dest": "/$1.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
